# ==========================================
# WorkStation Server - Production Environment Variables
# ==========================================

# Core Server Configuration
PORT=10000
NODE_ENV=production
CLIENT_URL=https://workstation.vercel.app

# Database (MongoDB Atlas Connection String)
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/workstation?retryWrites=true&w=majority&appName=WorkStation
MONGODB_URI=mongodb+srv://workstation_admin:YOUR_SECURE_PASSWORD@workstation-cluster.xxxxxx.mongodb.net/workstation?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
JWT_SECRET=your_production_jwt_access_secret_min_32_chars
JWT_ACCESS_SECRET=your_production_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Cloud Storage (Required for Avatars, Attachments, and Portfolios)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Razorpay or Stripe credentials)
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Dispatch (SMTP or Mailgun/SendGrid)
EMAIL_FROM=noreply@workstation.dev
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@workstation.dev
SMTP_PASS=your_smtp_password
